{
  "$schema": "https://modelcontextprotocol.io/schema/v1/server.json",
  "name": "eago-communication-agent",
  "version": "0.1.0",
  "open_eago": {
    "spec_version": "0.1.0",
    "eago_phases": ["communication_delivery"],
    "base_envelope": {
      "message_id": "required",
      "spec_version": "required",
      "phase": "required",
      "timestamp": "required",
      "payload": "required",
      "metadata": "optional"
    }
  },
  "tools": [
    {
      "name": "eago_health",
      "description": "OpenEAGO liveness and phase capability check.",
      "inputSchema": { "type": "object", "properties": {} }
    },
    {
      "name": "communication.deliver",
      "description": "Generate and deliver the customer-facing outcome message (spec/v0.1.0/schemas/communication-delivery.schema.json).",
      "inputSchema": {
        "type": "object",
        "required": ["recipient", "outcome_status"],
        "properties": {
          "recipient": { "type": "string" },
          "outcome_status": { "type": "string" },
          "audit_ref": { "type": "string" }
        }
      }
    }
  ],
  "resources": [],
  "prompts": []
}
