{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finos-labs.github.io/open-eago/spec/v0.1.0/schemas/contract-management.schema.json",
  "title": "OpenEAGO Contract Management",
  "type": "object",
  "required": ["contract_id", "requested_capabilities", "requester", "constraints"],
  "properties": {
    "contract_id": {
      "type": "string"
    },
    "requester": {
      "type": "string"
    },
    "requested_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Canonical capability type from domain-vocabulary.schema.json. Extension capabilities MUST use the 'x-' prefix.",
        "enum": [
          "kyc_verification",
          "aml_screening",
          "credit_risk_assessment",
          "legal_review",
          "cross_border_clearance",
          "sanctions_screening",
          "fraud_detection",
          "account_setup",
          "product_setup",
          "document_processing",
          "onboarding_orchestration",
          "compliance_validation",
          "data_residency_check",
          "audit_anchoring",
          "identity_verification",
          "risk_aggregation"
        ]
      },
      "minItems": 1
    },
    "constraints": {
      "type": "object",
      "properties": {
        "regulatory_profile": {
          "type": "string",
          "description": "Jurisdictional and regulatory context for this workflow. Canonical values from domain-vocabulary.schema.json.",
          "enum": [
            "financial_services_eu",
            "financial_services_us",
            "financial_services_global",
            "financial_services_apac",
            "healthcare_us",
            "global_enterprise"
          ]
        },
        "data_residency": {
          "type": "string"
        },
        "acu_budget": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "risk_tier": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    }
  },
  "additionalProperties": false
}
